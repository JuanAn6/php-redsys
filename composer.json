{
    "name": "juanan6/php-redsys",
    "description": "Librería sencilla para cobrar con el TPV Virtual de Redsys (modo Redirección) desde PHP o Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["redsys", "tpv", "payment", "laravel", "bizum", "pasarela"],
    "authors": [{"name": "JuanAn6"}],
    "require": {
        "php": "^8.1",
        "ext-openssl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "illuminate/support": "Para la integración con Laravel (ServiceProvider y Facade)"
    },
    "autoload": {
        "psr-4": {"JuanAn6\\Redsys\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"JuanAn6\\Redsys\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["JuanAn6\\Redsys\\Laravel\\RedsysServiceProvider"],
            "aliases": {"Redsys": "JuanAn6\\Redsys\\Laravel\\Facades\\Redsys"}
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:all": "for v in 8.1 8.2 8.3 8.4 8.5; do echo \"== PHP $v\"; php$v vendor/bin/phpunit --no-progress || exit 1; done"
    },
    "config": {"sort-packages": true},
    "minimum-stability": "stable"
}
